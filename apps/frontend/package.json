{
  "name": "@omnidraw/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run build:inspection",
    "build:inspection": "bun run scripts/build-inspection.ts",
    "dev:inspection": "bun run scripts/build-inspection.ts --watch",
    "dev:inspection:ready": "bun run scripts/build-inspection.ts --watch --reuse-current",
    "verify:inspection": "bun run scripts/verify-inspection-dist.ts",
    "preview": "vite preview",
    "test:unit": "bun test --isolate src scripts && bun ./node_modules/vitest/vitest.mjs --run",
    "test": "bun run typecheck && bun run test:unit && bun run build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "rollup": "^4.59.0",
    "typescript": "catalog:",
    "vite": "^8.1.4",
    "vite-plugin-wasm": "^3.5.0",
    "@solidjs/vite-plugin": "catalog:",
    "vitest": "^4.1.10",
    "esbuild": "^0.27.0"
  },
  "dependencies": {
    "@omnidraw/canvas": "workspace:*",
    "@omnidraw/canvas-contract": "workspace:*",
    "@omnidraw/component-ai-chat": "workspace:*",
    "@omnidraw/sdk": "workspace:*",
    "@omnidraw/theme": "workspace:*",
    "@solidjs/router": "catalog:",
    "@solidjs/web": "catalog:",
    "effect": "4.0.0-rc.108",
    "dompurify": "^3.3.3",
    "lucide-static": "catalog:",
    "solid-js": "catalog:"
  }
}
