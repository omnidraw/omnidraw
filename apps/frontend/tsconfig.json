{
  "compilerOptions": {
    // General
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "target": "ESNext",
    // Modules
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noEmit": true,
    // Type Checking & Safety
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@omnidraw/canvas": ["../../packages/canvas/src/index.ts"],
      "@omnidraw/canvas-contract": ["../../packages/canvas-contract/src/index.ts"],
      "@omnidraw/canvas-contract/CONSTANTS": ["../../packages/canvas-contract/src/CONSTANTS.ts"],
      "@omnidraw/component-ai-chat": ["../../packages/component-ai-chat/src/index.ts"],
      "@omnidraw/component-ai-chat/canvas-frame": ["../../packages/component-ai-chat/src/canvas-frame.ts"],
      "@omnidraw/sdk": ["../../packages/sdk/src/index.ts"],
      "@omnidraw/sdk/host": ["../../packages/sdk/src/host.ts"],
      "@omnidraw/theme": ["../../packages/theme/src/index.ts"]
    },
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun-types",
      "vite/client"
    ]
  },
  "include": [
    "src"
  ]
}
