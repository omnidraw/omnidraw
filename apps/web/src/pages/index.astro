---
import BaseLayout from "../layouts/BaseLayout.astro";
import CommandTabs from "../components/CommandTabs";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const docsHref = `${base}docs`;
const heroPngHref = `${base}hero.png`;
const heroWebpHref = `${base}hero.webp`;
const siteUrl = Astro.site ?? new URL("https://vibecanvas.dev");
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const docsUrl = new URL("docs", siteUrl).toString();
const seoImageUrl = new URL("seo.png", siteUrl).toString();
const title = "Vibecanvas - Generate live app widgets on an infinite canvas";
const description = "Vibecanvas is a generative app for creating live widgets with backend behavior and arranging them on an infinite canvas.";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      name: "Vibecanvas",
      url: siteUrl.toString(),
      description,
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${siteUrl}#software`,
      name: "Vibecanvas",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "macOS, Linux, Windows",
      url: canonicalUrl,
      image: seoImageUrl,
      description,
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "USD",
      },
    },
    {
      "@type": "WebPage",
      "@id": canonicalUrl,
      url: canonicalUrl,
      name: title,
      description,
      isPartOf: {
        "@id": `${siteUrl}#website`,
      },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: seoImageUrl,
        width: 1200,
        height: 630,
      },
      significantLink: docsUrl,
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  imageAlt="Vibecanvas infinite canvas with generated live app widgets"
  schema={schema}
>
  <div class="shell">
    <header class="topbar">
      <a href={base} class="brand" aria-label="Vibecanvas home">
        <span class="brand-wordmark">VIBECANVAS</span>
      </a>
      <nav class="topnav">
        <a href={docsHref}>Docs</a>
        <a class="github-link" href="https://github.com/vibecanvas/vibecanvas" target="_blank" rel="noreferrer">
          <svg class="github-mark" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.87c.68.003 1.36.092 2 .26 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          <span>GitHub</span>
        </a>
      </nav>
    </header>

    <section class="hero">
      <h1>Generate tiny apps across an infinite canvas.</h1>
      <p class="lead">Vibecanvas turns prompts into live widgets with real backend behavior, so you can compose dashboards, tools, forms, and workflows in one spatial app.</p>
      <figure class="hero-gif-frame">
        <picture>
          <source srcset={heroWebpHref} type="image/webp" />
          <img
            src={heroPngHref}
            alt="Vibecanvas infinite canvas with generated live app widgets"
            width="2400"
            height="1400"
            loading="eager"
          />
        </picture>
      </figure>
      <div class="hero-cta">
        <a class="btn btn-primary" href={docsHref}>Read Docs</a>
        <a class="btn btn-ghost" href="https://github.com/vibecanvas/vibecanvas" target="_blank" rel="noreferrer">View Repository</a>
      </div>
    </section>

    <section class="panel">
      <h2>Install Vibecanvas</h2>
      <p>Install with one command.</p>
      <CommandTabs client:load />
    </section>

    <section class="steps-grid">
      <article class="panel">
        <h3>1. Launch Vibecanvas</h3>
        <p>Start Vibecanvas locally and open a new infinite canvas.</p>
        <pre><code>vibecanvas
vibecanvas upgrade --check</code></pre>
      </article>
      <article class="panel">
        <h3>2. Generate app widgets</h3>
        <p>Create as many focused widgets as you need: charts, forms, queues, galleries, controls, and tools with live backend state.</p>
      </article>
      <article class="panel">
        <h3>3. Compose your app</h3>
        <p>Arrange widgets spatially, connect ideas visually, and keep generating new pieces as the workflow grows.</p>
        <a class="inline-link" href={docsHref}>Go to /docs</a>
      </article>
    </section>
  </div>
</BaseLayout>
