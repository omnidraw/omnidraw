---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase : `${rawBase}/`;
const docs = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<DocsLayout
  title="Omnidraw Docs"
  description="Guides for installing and using Omnidraw as a generative app canvas"
>
  <h1>Documentation</h1>
  <p>
    Start with Getting Started, then learn how to launch Omnidraw and generate live app widgets on the canvas.
  </p>

  <div class="docs-cards">
    {
      docs.map((entry) => (
        <a class="docs-card" href={`${base}docs/${entry.id}`}>
          <h2>{entry.data.title}</h2>
          <p>{entry.data.description}</p>
        </a>
      ))
    }
  </div>
</DocsLayout>
