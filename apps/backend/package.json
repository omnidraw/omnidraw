{
  "name": "@omnidraw/backend",
  "private": true,
  "type": "module",
  "imports": {
    "#backend/conformance/*": "./src/conformance/*",
    "#backend/core/*": "./src/core/*",
    "#backend/shell/*": "./src/shell/*",
    "#backend/sim/*": "./src/sim/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "predev": "bun run --cwd ../frontend build:inspection",
    "dev": "NODE_ENV=development bun run --watch ./src/main.ts",
    "benchmark:order-7": "bun run benchmarks/order-7.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@omnidraw/capsule": "catalog:",
    "@effect/platform-bun": "catalog:",
    "effect": "catalog:",
    "@tursodatabase/database": "catalog:",
    "@tursodatabase/database-common": "0.7.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@jridgewell/trace-mapping": "0.3.31",
    "@omnidraw/canvas-contract": "workspace:*",
    "@omnidraw/sdk": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csstype": "3.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "scheduler": "0.27.0",
    "typebox": "^1.3.6",
    "zod": "catalog:"
  },
  "devDependencies": {
    "playwright": "catalog:",
    "typescript": "catalog:"
  }
}
