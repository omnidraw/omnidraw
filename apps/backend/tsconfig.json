{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "outDir": "dist",
    "paths": {
      "#backend/*": ["./src/*"],
      "@omnidraw/canvas-contract": ["../../packages/canvas-contract/src/index.ts"],
      "@omnidraw/canvas-contract/CONSTANTS": ["../../packages/canvas-contract/src/CONSTANTS.ts"],
      "@omnidraw/canvas-contract/types": ["../../packages/canvas-contract/src/types.ts"],
      "@omnidraw/sdk": ["../../packages/sdk/src/index.ts"],
      "@omnidraw/sdk/conformance": ["../../packages/sdk/src/conformance.ts"],
      "@omnidraw/sdk/contract": ["../../packages/sdk/src/contract.ts"],
      "@omnidraw/sdk/package.json": ["../../packages/sdk/package.json"],
      "@omnidraw/sdk/server": ["../../packages/sdk/src/server.ts"],
      "@omnidraw/sdk/widget": ["../../packages/sdk/src/widget.ts"]
    },
    "types": ["bun-types"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/tests/**"
  ]
}
