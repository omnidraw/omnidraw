.omnidraw-widget {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  display: grid;
  place-items: center;
  gap: 12px;
  padding: 20px;
  background: #ffffff;
  color: #1f2937;
  font: 14px/1.5 system-ui, sans-serif;
}

.omnidraw-widget p,
.omnidraw-widget output { margin: 0; }

.omnidraw-widget button {
  padding: 6px 12px;
  border: 1px solid;
  border-radius: 6px;
  background: transparent;
  cursor: pointer;
}
