#!/usr/bin/env node

const { spawn } = require("child_process");
const { arch, platform } = require("os");

const os = platform();
const cpu = arch();

if (os === "win32") {
  console.error("omnidraw: Windows builds are not currently published.");
  process.exit(1);
}

const pkgBase = ["omnidraw", os, cpu].join("-");
const attempts = [pkgBase, `${pkgBase}-baseline`, `${pkgBase}-musl`];

let binaryPath;

for (const pkgName of attempts) {
  try {
    binaryPath = require.resolve(`${pkgName}/bin/omnidraw`);
    break;
  } catch {
    // Try next package variant.
  }
}

if (!binaryPath) {
  console.error(`omnidraw: no binary found for ${os}-${cpu}`);
  console.error(`omnidraw: tried ${attempts.join(", ")}`);
  process.exit(1);
}

const child = spawn(binaryPath, process.argv.slice(2), {
  stdio: "inherit",
  env: process.env,
});

child.on("error", (error) => {
  console.error(`omnidraw: failed to start binary (${error.message})`);
  process.exit(1);
});

child.on("exit", (code) => process.exit(code ?? 0));
