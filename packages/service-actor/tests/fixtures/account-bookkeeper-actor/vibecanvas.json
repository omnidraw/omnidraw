{
  "slug": "account-bookkeeper-test",
  "name": "Account Bookkeeper Test",
  "actor": {
    "relFunctionPath": "./actor/functions.ts",
    "initialState": "ready",
    "initialData": {
      "entries": []
    },
    "states": {
      "ready": {
        "on": {
          "funds-added": {
            "func": [
              "tx.persistFundsAdded"
            ],
            "allowedTargetStates": [
              "ready"
            ]
          }
        }
      }
    },
    "inputMsgSchema": {
      "funds-added": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "balance": {
            "type": "number"
          }
        },
        "required": [
          "accountId",
          "amount",
          "balance"
        ],
        "additionalProperties": false
      }
    },
    "outputMsgSchema": {}
  },
  "widget": {
    "relWidgetDir": "./widget",
    "tool": {
      "label": "Account Bookkeeper Test",
      "behavior": {
        "type": "mode",
        "mode": "click-create"
      }
    }
  }
}
