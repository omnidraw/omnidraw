{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibecanvas.dev/schemas/vibecanvas.schema.json",
  "title": "Vibecanvas widget manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "actor", "widget"],
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "actor": { "$ref": "#/$defs/actor" },
    "widget": { "$ref": "#/$defs/widget" }
  },
  "$defs": {
    "actorStateName": {
      "type": "string",
      "pattern": "^(booting|ready|busy|waiting|error)(\\..*)?$"
    },
    "nonErrorActorStateName": {
      "type": "string",
      "pattern": "^(booting|ready|busy|waiting)(\\..*)?$"
    },
    "functionName": {
      "type": "string",
      "pattern": "^(fn|fx|tx)\\..+$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "jsonSchema": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "object", "additionalProperties": true }
      ]
    },
    "errorHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["func", "recover"],
      "properties": {
        "func": {
          "type": "array",
          "items": { "$ref": "#/$defs/functionName" }
        },
        "recover": {
          "oneOf": [
            { "const": "stay" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["targetState"],
              "properties": {
                "targetState": { "$ref": "#/$defs/nonErrorActorStateName" }
              }
            }
          ]
        }
      }
    },
    "targetTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["func", "targetState"],
      "properties": {
        "func": {
          "type": "array",
          "items": { "$ref": "#/$defs/functionName" }
        },
        "targetState": { "$ref": "#/$defs/actorStateName" },
        "onError": { "$ref": "#/$defs/errorHandler" }
      }
    },
    "legacyTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["func", "allowedTargetStates"],
      "properties": {
        "func": {
          "type": "array",
          "items": { "$ref": "#/$defs/functionName" }
        },
        "allowedTargetStates": {
          "type": "array",
          "items": { "$ref": "#/$defs/actorStateName" }
        },
        "onError": { "$ref": "#/$defs/errorHandler" }
      },
      "deprecated": true
    },
    "transition": {
      "oneOf": [
        { "$ref": "#/$defs/targetTransition" },
        { "$ref": "#/$defs/legacyTransition" }
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["everyMs", "func"],
      "properties": {
        "everyMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2147483647
        },
        "func": {
          "type": "array",
          "items": { "$ref": "#/$defs/functionName" }
        },
        "runImmediately": { "type": "boolean" },
        "onError": { "$ref": "#/$defs/errorHandler" }
      }
    },
    "actorState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on"],
      "properties": {
        "on": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/transition" }
        },
        "activity": { "$ref": "#/$defs/activity" },
        "onEnter": {
          "type": "array",
          "items": { "$ref": "#/$defs/functionName" }
        },
        "onExit": {
          "type": "array",
          "items": { "$ref": "#/$defs/functionName" }
        },
        "onError": { "$ref": "#/$defs/errorHandler" }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relFunctionPath", "initialState", "initialData", "states"],
      "properties": {
        "relFunctionPath": { "type": "string", "minLength": 1 },
        "initialState": { "$ref": "#/$defs/actorStateName" },
        "initialData": { "$ref": "#/$defs/jsonValue" },
        "dataSchema": { "$ref": "#/$defs/jsonSchema" },
        "states": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/actorStateName" },
          "additionalProperties": { "$ref": "#/$defs/actorState" }
        },
        "inputMsgSchema": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonSchema" }
        },
        "outputMsgSchema": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonSchema" }
        }
      }
    },
    "toolIcon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lucidIcon": { "type": "string", "minLength": 1 },
        "svgIcon": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "required": ["lucidIcon"] },
        { "required": ["svgIcon"] }
      ]
    },
    "toolBehavior": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "mode"],
          "properties": {
            "type": { "const": "mode" },
            "mode": { "enum": ["draw-create", "click-create", "select", "hand"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "action" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "modal" } }
        }
      ]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "behavior"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "icon": { "$ref": "#/$defs/toolIcon" },
        "group": { "type": "string" },
        "priority": { "type": "number" },
        "behavior": { "$ref": "#/$defs/toolBehavior" }
      }
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relWidgetDir", "tool"],
      "properties": {
        "relWidgetDir": { "type": "string", "minLength": 1 },
        "tool": { "$ref": "#/$defs/tool" }
      }
    }
  }
}
