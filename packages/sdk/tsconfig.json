{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@omnidraw/sdk/widget": ["./src/widget.ts"],
      "@omnidraw/sdk/server": ["./src/server.ts"],
      "@omnidraw/sdk/function-client": ["./src/function-client.ts"],
      "@omnidraw/canvas/*": ["../canvas/src/*"],
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
