{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "@vibecanvas/canvas/*": ["../canvas/src/*"],
      "@vibecanvas/service-automerge/*": ["../service-automerge/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
