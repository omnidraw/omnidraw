{
  "name": "@omnidraw/sdk",
  "version": "0.5.0",
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    "./widget": {
      "types": "./dist/widget.d.ts",
      "default": "./dist/widget.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./function-client": {
      "types": "./dist/function-client.d.ts",
      "default": "./dist/function-client.js"
    }
  },
  "files": [
    "dist",
    "function-client",
    "server",
    "widget"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "bun test --pass-with-no-tests",
    "typecheck": "tsc --noEmit -p tsconfig.type-tests.json"
  },
  "dependencies": {
    "@omnidraw/capsule": "0.10.2",
    "@omnidraw/widget-contract": "0.5.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
