{
  "name": "@omnidraw/service-theme",
  "version": "0.5.0",
  "description": "Isolated theme capability, built-in themes, tokens, and DOM helpers for Omnidraw hosts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecanvas/vibecanvas.git",
    "directory": "packages/service-theme"
  },
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": ["./dist/*.css"],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default.css": "./dist/default.css",
    "./canvas-default.css": "./dist/canvas-default.css"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@omnidraw/theme-contract": "0.5.0"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  }
}
