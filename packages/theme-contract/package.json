{
  "name": "@omnidraw/theme-contract",
  "version": "0.5.0",
  "description": "State-free Omnidraw theme and semantic canvas color contracts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecanvas/vibecanvas.git",
    "directory": "packages/theme-contract"
  },
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./CONSTANTS": {
      "types": "./dist/CONSTANTS.d.ts",
      "default": "./dist/CONSTANTS.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./fn.validation": {
      "types": "./dist/fn.validation.d.ts",
      "default": "./dist/fn.validation.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  }
}
