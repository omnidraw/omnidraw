{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@omnidraw/canvas-contract": ["../canvas-contract/dist/index.d.ts"],
      "@omnidraw/runtime": ["../runtime/dist/index.d.ts"]
    },
    "rootDir": "src",
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["tests", "src/**/*.test.ts"]
}
