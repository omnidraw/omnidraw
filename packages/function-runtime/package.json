{
  "name": "@omnidraw/function-runtime",
  "version": "0.8.1",
  "description": "Portable direct function execution and resource-call contracts for Omnidraw.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecanvas/vibecanvas.git",
    "directory": "packages/function-runtime"
  },
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./local": "./src/local/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-typescript-package.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnidraw/resource-runtime": "workspace:*",
    "@omnidraw/widget-contract": "workspace:*",
    "ajv": "^8.20.0"
  }
}
