{
  "name": "@vibecanvas/widget-filesystem",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./main.js": "./dist/main.js",
    "./main.css": "./dist/main.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/widget.ts --bundle --format=esm --platform=browser --target=es2022 --loader:.svg=dataurl --external:@arrow-js/core --outfile=dist/main.js",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@arrow-js/core": "^1.0.6",
    "@codemirror/state": "^6.6.0",
    "lucide-static": "^1.11.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "typescript": "catalog:"
  }
}
