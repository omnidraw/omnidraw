{
  "name": "@omnidraw/widget-contract",
  "version": "0.5.2",
  "description": "Portable widget manifests, artifacts, diagnostics, and revision contracts for Omnidraw.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecanvas/vibecanvas.git",
    "directory": "packages/widget-contract"
  },
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/index.ts",
    "./CONSTANTS": "./src/CONSTANTS.ts",
    "./fn.diagnostic": "./src/core/fn.diagnostic.ts",
    "./core/fn.widget-frame": "./src/core/fn.widget-frame.ts",
    "./fn.widget-frame": "./src/core/fn.widget-frame.ts",
    "./local": "./src/local/index.ts"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-typescript-package.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnidraw/resource-runtime": "workspace:*",
    "@omnidraw/tenant-core": "workspace:*",
    "lucide-static": "^1.24.0",
    "zod": "4.4.3"
  }
}
