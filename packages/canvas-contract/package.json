{
  "name": "@omnidraw/canvas-contract",
  "version": "0.5.0",
  "description": "Portable Omnidraw canvas document contracts and validation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecanvas/vibecanvas.git",
    "directory": "packages/canvas-contract"
  },
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./CONSTANTS": {
      "types": "./dist/CONSTANTS.d.ts",
      "default": "./dist/CONSTANTS.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./validation": {
      "types": "./dist/validation.d.ts",
      "default": "./dist/validation.js"
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@omnidraw/cangine": "0.5.3"
  },
  "devDependencies": {
    "bun-types": "1.3.14",
    "typescript": "7.0.2"
  }
}
