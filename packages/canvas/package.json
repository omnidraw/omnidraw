{
  "name": "@omnidraw/canvas",
  "version": "0.12.0",
  "description": "Portable Solid canvas host, Cangine runtime, and optimistic document client for Omnidraw.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnidraw/omnidraw.git",
    "directory": "packages/canvas"
  },
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "ARCHITECTURE.md",
    "LICENSE",
    "README.md",
    "src/assets/fonts/*OFL.txt",
    "src/assets/fonts/README.md"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./debug-trace": {
      "types": "./dist/debug-trace/index.d.ts",
      "import": "./dist/debug-trace/index.js",
      "default": "./dist/debug-trace/index.js"
    },
    "./extension": {
      "types": "./dist/extension.d.ts",
      "import": "./dist/extension.js",
      "default": "./dist/extension.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun run scripts/prune-private-declarations.ts && bun run ../../scripts/prepare-package-dist.ts",
    "dev:bundle": "vite build --watch --mode kernel-watch",
    "dev:types": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "prepack": "bun run build",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnidraw/cangine": "0.7.0",
    "@omnidraw/canvas-contract": "workspace:*",
    "@omnidraw/theme": "workspace:*",
    "effect": "4.0.0-rc.108"
  },
  "peerDependencies": {
    "@solidjs/web": "2.0.0-rc.0",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/web": "catalog:",
    "jsdom": "^29.1.1",
    "solid-js": "catalog:",
    "typescript": "7.0.2",
    "vite": "^8.1.4",
    "@solidjs/vite-plugin": "catalog:",
    "vitest": "^4.1.10"
  }
}
