{
  "name": "@omnidraw/capsule-omnidraw",
  "version": "0.6.0",
  "description": "Omnidraw Capsule contracts, widget builds, capabilities, and browser hosting adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibecanvas/vibecanvas.git",
    "directory": "packages/capsule-omnidraw"
  },
  "publishConfig": {
    "@omnidraw:registry": "https://registry.npmjs.org/",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./contract": "./src/contract/index.ts",
    "./build": "./src/build/index.ts",
    "./builder": "./src/builder/index.ts",
    "./host": "./src/host/index.ts",
    "./host/fn.error": "./src/host/fn.error.ts",
    "./authoring-inspection": "./src/authoring-inspection/index.ts",
    "./capabilities": "./src/capabilities/index.ts",
    "./testkit": "./src/testkit/index.ts"
  },
  "scripts": {
    "build": "bun run ../../scripts/build-typescript-package.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnidraw/capsule": "catalog:",
    "@omnidraw/widget-contract": "workspace:*"
  }
}
