{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "composite": false,
    "declarationMap": false,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@omnidraw/tenant-core": ["../tenant-core/dist/index.d.ts"],
      "@omnidraw/widget-contract": ["../widget-contract/dist/index.d.ts"]
    },
    "rootDir": "src",
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["tests", "src/**/*.test.ts"]
}
