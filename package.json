{
  "name": "omnidraw-workspace",
  "private": true,
  "description": "Run your agents in an infinite canvas",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@omnidraw/capsule": "0.14.0",
    "@effect/platform-bun": "4.0.0-rc.108",
    "effect": "4.0.0-rc.108",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "typescript": "7.0.2",
    "zod": "4.4.3",
    "@kobalte/core": "^0.13.12",
    "lucide-solid": "^1.24.0",
    "lucide-static": "1.24.0",
    "solid-js": "^1.9.14",
    "@tursodatabase/database": "0.7.2",
    "playwright": "1.61.1"
  },
  "scripts": {
    "pretest": "bun run build:public",
    "test": "bun run test:typecheck && bun run test:workspace && bun run test:architecture && bun run test:conformance && bun run test:db && bun run test:packed-public-composition && bun run test:browser",
    "test:typecheck": "bun run --sequential --filter '@omnidraw/backend' --filter '@omnidraw/frontend' --filter '@omnidraw/canvas-contract' --filter '@omnidraw/canvas' --filter '@omnidraw/sdk' --filter '@omnidraw/component-ai-chat' --filter '@omnidraw/theme' typecheck",
    "test:workspace": "bun run --sequential --filter '@omnidraw/backend' --filter '@omnidraw/frontend' --filter '@omnidraw/canvas-contract' --filter '@omnidraw/canvas' --filter '@omnidraw/sdk' --filter '@omnidraw/component-ai-chat' --filter '@omnidraw/theme' test",
    "pretest:architecture": "bun run build:public",
    "test:architecture": "bun test scripts/public-packages.test.ts scripts/architecture-boundaries.test.ts scripts/prepare-package-dist.test.ts scripts/verify-package-dists.test.ts scripts/list-package-deployments.test.ts scripts/local-registry.test.mjs scripts/link-local-packages.test.mjs",
    "test:conformance": "bun run scripts/generate-private-operation-manifest.ts && bun test tests/transport && bun run test:backend:conformance && bun run test:frontend:conformance",
    "test:backend:conformance": "bun test apps/backend/src/conformance apps/backend/src/sim",
    "test:frontend:conformance": "bun test apps/frontend/src/conformance apps/frontend/src/sim",
    "test:db": "bun run db:schema:verify && bun run db:constraints:test && bun run db:recovery:test",
    "test:packed-public-composition": "bun run scripts/test-packed-public-composition.ts && bun run scripts/test-packed-sdk-offline-check.ts",
    "test:browser": "bun run test:browser:typecheck && bun run scripts/test-packed-canvas.ts && bun run test:browser:live",
    "test:browser:typecheck": "bun x tsc --noEmit -p tests/browser/tsconfig.json",
    "test:browser:live": "bun run tests/browser/live-app.acceptance.ts",
    "verify:package-dists": "bun run scripts/verify-package-dists.ts",
    "deploy:packages:list": "bun run scripts/list-package-deployments.ts",
    "test:final-acceptance": "bun run scripts/test-final-acceptance.ts",
    "db:schema:verify": "bun test apps/backend/src/shell/database/verification/pinned-runtime-features.test.ts apps/backend/src/shell/database/verification/baseline-schema.test.ts",
    "db:constraints:test": "bun test apps/backend/src/shell/database/verification/baseline-constraints.test.ts",
    "db:recovery:test": "bun test apps/backend/src/shell/database/tests/BunServiceTurso/fx.migration-file.test.ts apps/backend/src/shell/database/tests/BunServiceTurso/tx.migrations.test.ts apps/backend/src/shell/database/verification/baseline-recovery.test.ts",
    "db:evidence:capture": "bun run scripts/capture-m1-database-evidence.ts",
    "prebenchmark:order-7": "bun run build:public",
    "benchmark:order-7": "bun run --cwd apps/backend benchmark:order-7",
    "test:ci:docker": "bun run scripts/test-ci-docker.ts",
    "build": "bun run build:public && bun run --sequential --filter '@omnidraw/backend' --filter '@omnidraw/frontend' build",
    "build:public": "bun run --cwd packages/theme build && bun run --cwd packages/canvas-contract build && bun run --cwd packages/sdk build && bun run --cwd packages/canvas build && bun run --cwd packages/component-ai-chat build",
    "registry:start": "node scripts/local-registry.mjs start",
    "registry:start:foreground": "node scripts/local-registry.mjs start-foreground",
    "registry:ensure": "node scripts/local-registry.mjs ensure",
    "registry:status": "node scripts/local-registry.mjs status",
    "registry:stop": "node scripts/local-registry.mjs stop",
    "registry:bootstrap": "node scripts/local-registry.mjs bootstrap",
    "registry:publish": "node scripts/local-registry.mjs publish",
    "registry:publish:sdk": "node scripts/local-registry.mjs publish-widget-packages",
    "link:local": "node scripts/link-local-packages.mjs",
    "link:local:reset": "node scripts/link-local-packages.mjs reset",
    "changeset:add": "changeset add",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "predev": "bun run build:public",
    "dev": "bun run scripts/dev.ts",
    "preclient:dev": "bun run build:public",
    "client:dev": "bun run scripts/dev-frontend.ts",
    "server:dev": "cd apps/backend && NODE_ENV=development bun run --watch src/main.ts serve",
    "server:prod": "bun run build && cd apps/backend && NODE_ENV=production bun run src/main.ts serve --port 7496"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@omnidraw/cangine": "0.6.1",
    "bun-types": "^1.3.14",
    "effect": "catalog:",
    "playwright": "catalog:",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "prosemirror-model": "1.25.11",
    "prosemirror-view": "1.42.1",
    "vite": "8.1.4"
  }
}
